an class=\"nf\">#content</span><span class=\"p\">{</span>\n                <span class=\"nl\">position</span><span class=\"p\">:</span> <span class=\"nb\">absolute</span><span class=\"p\">;</span>\n                <span class=\"nl\">color</span><span class=\"p\">:</span> <span class=\"nx\">white</span><span class=\"p\">;</span>\n                <span class=\"nl\">top</span><span class=\"p\">:</span> <span class=\"m\">30%</span><span class=\"p\">;</span>\n                <span class=\"nl\">left</span><span class=\"p\">:</span> <span class=\"m\">50%</span><span class=\"p\">;</span>\n                <span class=\"nl\">margin-left</span><span class=\"p\">:</span> <span class=\"m\">-121px</span><span class=\"p\">;</span>\n            <span class=\"p\">}</span>\n            \n            <span class=\"nt\">p</span><span class=\"p\">{</span>\n                <span class=\"nl\">font-family</span><span class=\"p\">:</span> <span class=\"n\">calligraffittiregular</span>\n            <span class=\"p\">}</span>\n            \n        <span class=\"nt\">&lt;/style&gt;</span>\n    <span class=\"nt\">&lt;/head&gt;</span>\n\n    <span class=\"nt\">&lt;body&gt;</span>\n        <span class=\"nt\">&lt;div</span> <span class=\"na\">id=</span><span class=\"s\">\"content\"</span><span class=\"nt\">&gt;</span>\n            <span class=\"nt\">&lt;p</span> <span class=\"na\">style=</span><span class=\"s\">\"font-size:  40px;font-weight: 1000;\"</span><span class=\"nt\">&gt;</span>MinecraftClientStatic<span class=\"nt\">&lt;/p&gt;</span>\n        <span class=\"nt\">&lt;/div&gt;</span>\n        <span class=\"nt\">&lt;canvas</span> <span class=\"na\">id=</span><span class=\"s\">\"hacker\"</span> <span class=\"na\">style=</span><span class=\"s\">\"width:100%;height:100%;\"</span><span class=\"nt\">&gt;</span>请使用最新的浏览器<span class=\"nt\">&lt;/canvas&gt;</span>\n    <span class=\"nt\">&lt;/body&gt;</span>\n\n<span class=\"nt\">&lt;/html&gt;</span>\n<span class=\"nt\">&lt;script </span><span class=